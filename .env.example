# ——— Copiez ce fichier en .env.local et complétez les valeurs ———

# URL publique du site (utilisée dans les emails : liens d'annulation, espace admin)
NEXT_PUBLIC_SITE_URL=https://www.lessoinsdebea.fr

# Base PostgreSQL de production (Neon, Supabase, Vercel Postgres…).
# Laisser vide en local : une base PGlite est créée automatiquement dans .data/
DATABASE_URL=

# Espace admin (/admin)
ADMIN_PASSWORD=choisir-un-mot-de-passe-solide
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 32)
SESSION_SECRET=

# Brevo (emails transactionnels) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Adresse d'expédition, vérifiée dans Brevo (Expéditeurs & domaines)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Les Soins de Béa
# Adresse de Béa qui reçoit les nouvelles demandes et les messages de contact
ADMIN_EMAIL=

# Rappels automatiques la veille (Vercel Cron) — chaîne aléatoire
CRON_SECRET=
